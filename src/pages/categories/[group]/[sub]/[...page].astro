---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getCategoryTree } from "@/utils/getUniqueCategories";
import { getPostCategoryPath } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCategoryInfo } from "@/utils/getCategoryInfo";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tree = getCategoryTree(posts);

  return tree.flatMap(({ group, subs }) =>
    subs.flatMap(({ sub }) => {
      const subPosts = getSortedPosts(
        posts.filter(({ filePath }) => {
          const [g, s] = getPostCategoryPath(filePath);
          return g === group && s === sub;
        })
      );

      return paginate(subPosts, {
        params: { group, sub },
        props: { group, sub },
        pageSize: config.posts.perPage,
      });
    })
  );
}

const { page, group, sub } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const name = `${group} / ${sub}`;
const pageSuffix =
  page.currentPage > 1 ? ` (${t.pagination.page} ${page.currentPage})` : "";
const info = getCategoryInfo([group, sub]);
const groupInfo = getCategoryInfo([group]);
const heading = info ? info.label : `${t.pages.categoryTitle}: ${name}`;
const titleText = info
  ? `${info.label} - ${groupInfo?.label ?? group}`
  : `${t.pages.categoryTitle}: ${name}`;
const pageDesc = info?.description ?? `${t.pages.categoryDesc} "${name}".`;
---

<Layout
  title={`${titleText}${pageSuffix} | ${config.site.title}`}
  description={pageDesc}
  noindex={page.currentPage > 1}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={heading}
    {pageDesc}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
