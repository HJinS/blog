---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  path: string[];
  label?: string;
  count?: number;
  size?: "sm" | "lg";
};

const { path, label = path.join(" / "), count, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `categories/${path.join("/")}/`)}
    transition:name={path.join("-")}
    class:list={[
      "flex items-center gap-1",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    {label}
    {count !== undefined && <span class="opacity-60">({count})</span>}
  </a>
</li>
